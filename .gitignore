# GitIgnore Configuration File
# -----------------------------------------------------------------------------
# This file specifies intentionally untracked files and directories that Git
# should ignore. It prevents heavy local compilation folders (like node_modules
# and .next) or private local environment keys (.env files) from being committed
# or pushed to your public GitHub repository.
# -----------------------------------------------------------------------------

# dependencies (heavy local downloads from npm install)
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing reports
/coverage

# next.js local compilation build caches
/.next/
/out/

# production output builds
/build

# misc system junk
.DS_Store
*.pem

# debug log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env keys (keeps private credentials secret)
.env*

# vercel local cloud setup credentials
.vercel

# typescript incremental compilation cache outputs
*.tsbuildinfo
next-env.d.ts
